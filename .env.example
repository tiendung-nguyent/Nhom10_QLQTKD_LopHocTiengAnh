# Copy to .env for local development. Never commit .env.

# Django core
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SITE_ID=2

# Database (leave empty to use local db.sqlite3)
DATABASE_URL=

# Google SSO (django-allauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI grading
GEMINI_API_KEY=

# Gmail SMTP app password for result/tuition emails
EMAIL_HOST_PASSWORD=

# Superuser created by `python manage.py init_admin` (skipped when ADMIN_PASSWORD is empty)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
